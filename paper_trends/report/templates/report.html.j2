<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ r.name }} · paper-trends</title>
<meta name="description" content="How {{ r.name }} changed {{ r.year_range[0] }}–{{ r.year_range[1] }}: rising and fading topics, new vocabulary, who publishes. Built from OpenAlex.">
{% if inline_css %}<style>{{ inline_css }}</style>{% else %}<link rel="stylesheet" href="report.css">{% endif %}
<script src="https://cdn.jsdelivr.net/npm/vega@5.30.0"></script>
<script src="https://cdn.jsdelivr.net/npm/vega-lite@5.21.0"></script>
<script src="https://cdn.jsdelivr.net/npm/vega-embed@6.26.0"></script>
</head>
<body class="{{ 'embedded' if embedded else '' }}">
{% if nav %}<nav class="masthead"><div class="row">
  <a class="brand" href="{{ './' if app_links else 'index.html' }}"{{ ' target="_top"' if app_links else '' }}>paper-trends</a>
  <span class="tagline">{{ tagline }}</span>
  <a class="all" href="{{ './' if app_links else 'index.html' }}"{{ ' target="_top"' if app_links else '' }}>All conferences →</a>
</div></nav>{% endif %}

<main class="page{{ ' embedded' if embedded else '' }}">
<header class="title">
  <div class="kicker">Publication trends · {{ r.year_range[0] }}–{{ r.year_range[1] }}</div>
  <h1>{{ r.name }}</h1>
  <div class="meta">
    <span><b>{{ "{:,}".format(r.n_papers) }}</b> papers</span>
    <span><b>{{ r.years|length }}</b> editions</span>
    <span><b>{{ "%.0f"|format(r.abstract_coverage * 100) }}%</b> with abstracts</span>
    <span>data from OpenAlex, fetched {{ r.generated }}</span>
  </div>
</header>

<section id="glance">
  <h2>At a glance</h2>
  <ul class="glance">{% for s in r.glance %}<li>{{ s }}</li>{% endfor %}</ul>
  <figure style="max-width: 520px; margin-top: 28px">
    <figcaption><span class="headline">Papers per year</span><span class="sub">{{ r.growth_sentence[0]|upper }}{{ r.growth_sentence[1:] }}; abstract coverage {{ "%.0f"|format(r.abstract_coverage * 100) }}%{{ r.coverage_note }}.</span></figcaption>
    <div class="viz" id="fig-papers"></div>
  </figure>
</section>

<section id="rising">
  <h2>What is rising</h2>
  <p class="lede">Share of papers that are <em>about</em> the phrase: it is in the title or used more than once{{ " (titles only: OpenAlex lacks most abstracts for this venue)" if r.text_mode == "title" else "" }}; a single mention does not count. One phrase per family — variants such as “wafer hybrid bonding” are listed under it. Ranked by the gain between the first half of the period ({{ r.year_range[0] }}–{{ r.split_year - 1 }}) and the second ({{ r.split_year }}–{{ r.year_range[1] }}).</p>
  <div class="grid">
  {% for t in r.rising %}
    <figure>
      <p class="term"><span class="ent" data-ent="term" data-name="{{ t.term }}">{{ t.term }}</span></p>
      <p class="move">{{ "%.1f"|format(t.early*100) }}% → <span class="up">{{ "%.1f"|format(t.late*100) }}%</span></p>
      {% if t.variants %}<p class="variants">also {% for v in t.variants %}<span class="ent" data-ent="term" data-name="{{ v }}">{{ v }}</span>{{ ", " if not loop.last }}{% endfor %}</p>{% endif %}
      <div class="viz" id="fig-rise-{{ loop.index }}"></div>
    </figure>
  {% endfor %}
  </div>
  <p class="source">OpenAlex · paper-trends</p>
</section>

<section id="fading">
  <h2>What is fading</h2>
  <p class="lede">The same measure for the phrases losing the most share. A fading phrase is often a technique that became standard and stopped being worth mentioning. Click any phrase, institution or topic on this page to see who writes about it, what it travels with and the papers behind it.</p>
  <div class="grid">
  {% for t in r.falling %}
    <figure class="fading">
      <p class="term"><span class="ent" data-ent="term" data-name="{{ t.term }}">{{ t.term }}</span></p>
      <p class="move">{{ "%.1f"|format(t.early*100) }}% → <span class="down">{{ "%.1f"|format(t.late*100) }}%</span></p>
      {% if t.variants %}<p class="variants">also {% for v in t.variants %}<span class="ent" data-ent="term" data-name="{{ v }}">{{ v }}</span>{{ ", " if not loop.last }}{% endfor %}</p>{% endif %}
      <div class="viz" id="fig-fall-{{ loop.index }}"></div>
    </figure>
  {% endfor %}
  </div>
  <p class="source">OpenAlex · paper-trends</p>
</section>

<section id="vocabulary">
  <h2>New vocabulary</h2>
  <p class="lede">Phrases that were almost absent before {{ r.split_year }} and now appear in at least one paper in a hundred. ✚ marks the first year a phrase shows up.</p>
  <figure style="max-width: 760px">
    <div class="viz" id="fig-emerging"></div>
    <p class="source">OpenAlex · paper-trends</p>
  </figure>
</section>

<section id="topics">
  <h2>How the field's topics shifted</h2>
  <p class="lede">{{ r.topic_sentence }}</p>
  <figure class="wide">
    <figcaption><span class="headline">Share of papers by dominant topic</span><span class="sub">Topics fitted with NMF on titles and abstracts; each paper assigned to its strongest topic. Smaller topics folded into “Other”.</span></figcaption>
    <div class="viz" id="fig-topics"></div>
    <p class="source">OpenAlex · paper-trends</p>
  </figure>
  <ul class="topic-list">
  {% for t in r.topics %}
    <li><span class="swatch" style="background: {{ topic_colors[loop.index0] if loop.index0 < topic_colors|length else other_color }}"></span><b class="ent" data-ent="topic" data-name="{{ t.label }}">{{ t.label }}</b> — {{ t.terms[:6]|join(', ') }} <span style="color: var(--faint)">({{ t.papers }} papers)</span></li>
  {% endfor %}
  </ul>
</section>

<section id="who">
  <h2>Who publishes</h2>
  <p class="lede">Papers with at least one author at the institution (a paper counts once per institution; subsidiaries and institutes are credited to their parent). The arrow is the change in share of papers between the two halves of the period.</p>
  <figure class="wide" style="margin-bottom: 36px">
    <figcaption><span class="headline">Where the papers come from</span><span class="sub">Share of papers with at least one author in the country. Countries without a paper are left blank. Single years are three-year rolling shares, so the picture moves rather than jumps.</span></figcaption>
    {% if r.map_lines %}
    <div class="map-ctl" id="map-ctl">
      <a href="#" data-year="0" class="on" id="map-all">{{ r.year_range[0] }}–{{ r.year_range[1] }}</a>
      <input type="range" id="map-range" min="{{ r.year_range[0] }}" max="{{ r.year_range[1] }}" step="1" value="{{ r.year_range[0] }}" aria-label="Year">
      <span class="map-year" id="map-year">{{ r.year_range[0] }}</span>
      <a href="#" id="map-play">▶ Play</a>
      <span class="map-line" id="map-line">{{ r.map_lines["0"] }}</span>
    </div>
    {% endif %}
    <div class="viz" id="fig-map"></div>
  </figure>
  <div class="two">
    <figure>
      <figcaption><span class="headline">Institutions</span></figcaption>
      <div class="viz" id="fig-inst"></div>
    </figure>
    <figure>
      <figcaption><span class="headline">Countries</span></figcaption>
      <div class="viz" id="fig-country"></div>
    </figure>
  </div>
  <p class="source">OpenAlex · paper-trends</p>
  {% if r.inst_ranks %}
  <figure class="wide" style="margin-top: 44px">
    <figcaption><span class="headline">{{ r.inst_rank_sentence }}</span><span class="sub">Rank among the ten most prolific institutions, on a three-year rolling count of papers. Red lines climbed three places or more, blue lines slipped.</span></figcaption>
    <div class="viz" id="fig-bump"></div>
    <p class="source">OpenAlex · paper-trends</p>
  </figure>
  {% endif %}
  {% if r.inst_topic %}
  <figure class="wide" style="margin-top: 36px">
    <figcaption><span class="headline">{{ r.inst_topic_sentence }}</span><span class="sub">Share of each institution's papers whose dominant topic is the column; each row sums to 100 %. Dark cells are specialities.</span></figcaption>
    <div class="viz" id="fig-heat"></div>
    <p class="source">OpenAlex · paper-trends</p>
  </figure>
  {% endif %}
</section>

<footer class="about" id="about">
  <h2>About the data</h2>
  <p>Metadata for every {{ r.name }} paper from {{ r.year_range[0] }} to {{ r.year_range[1] }} was pulled from <a href="https://openalex.org" target="_blank" rel="noopener">OpenAlex</a> (CC0). Front matter such as title pages and session overviews is removed. Phrases are word sequences taken from titles and abstracts; OpenAlex has no full text. A paper counts for a phrase when it is about it — the phrase is in its title or mentioned more than once — so a sentence like “with the rise of artificial intelligence…” does not make a paper an AI paper, and a method used once does not become its subject. Acronyms the corpus defines (“redistribution layer (RDL)”) are read as the same phrase. Fragments that almost always sit inside a longer phrase (“level packaging”) are folded into it, and the lists show one phrase per family. {% if r.n_common_hidden %}{{ r.n_common_hidden }} phrases that are common in three or more other fields ({{ r.common_examples|join(", ") }}…) are left out of the rankings, because they say little about this conference in particular. {% endif %}“Rising” and “fading” compare the pooled share of the first half of the period with the second.</p>
  <p>Topics come from non-negative matrix factorisation of TF-IDF vectors with a fixed seed, so they are reproducible; labels are the topic's top terms. Institution names and parent relationships are OpenAlex's, which are good but not perfect.</p>
  <details><summary>Coverage by year</summary>
    <table><thead><tr><th>Year</th><th class="num">Papers</th><th class="num">With abstract</th></tr></thead><tbody>
    {% for row in r.papers_per_year %}<tr><td>{{ row.year }}</td><td class="num">{{ row.papers }}</td><td class="num">{{ "%.0f"|format(row.abstracts / row.papers * 100) }}%</td></tr>{% endfor %}
    </tbody></table>
  </details>
  <p style="margin-top: 20px">Generated {{ r.generated }} by <a href="https://github.com/Minjia-Hu/paper-trends" target="_blank" rel="noopener">paper-trends</a>.</p>
</footer>
</main>

<script>
const specs = {{ specs_json }};
const opts = { actions: false, renderer: "svg" };
window.ENTITIES = {{ entities_json }};
window.VIEWS = {};
const jobs = Object.entries(specs).map(([id, spec]) => vegaEmbed("#" + id, spec, opts).then((res) => {
  window.VIEWS[id] = res.view;
  // marks of some figures open the detail panel
  const kind = { "fig-inst": ["inst", "name"], "fig-bump": ["inst", "name"], "fig-heat": ["inst", "name"], "fig-topics": ["topic", "topic"], "fig-emerging": ["term", "term"] }[id] || null;
  if (kind) {  // openEntity is defined by a later script, so look it up when the click happens
    res.view.addEventListener("click", (ev, item) => { const v = item && item.datum && item.datum[kind[1]]; if (v != null && v !== "Other" && window.openEntity) window.openEntity(kind[0], v); });
    document.getElementById(id).style.cursor = "pointer";
  }
  return res;
}));
// the map's year control: 0 = the whole period, otherwise a three-year rolling view
(function () {
  const ctl = document.getElementById("map-ctl");
  if (!ctl) return;
  const lines = {{ map_lines_json }};
  const range = document.getElementById("map-range"), all = document.getElementById("map-all"), play = document.getElementById("map-play");
  const yearEl = document.getElementById("map-year"), line = document.getElementById("map-line");
  const y0 = +range.min, y1 = +range.max;
  let timer = null;
  function stop() { if (timer) { clearInterval(timer); timer = null; play.textContent = "▶ Play"; } }
  function set(y) {
    all.classList.toggle("on", y === 0); yearEl.classList.toggle("on", y !== 0);
    if (y) { range.value = y; yearEl.textContent = y; }
    line.textContent = lines[String(y)] || "";
    const view = window.VIEWS["fig-map"];
    if (view) view.signal("year", y).runAsync();
  }
  range.addEventListener("input", () => { stop(); set(+range.value); });
  all.addEventListener("click", (ev) => { ev.preventDefault(); stop(); set(0); });
  play.addEventListener("click", (ev) => {
    ev.preventDefault();
    if (timer) return stop();
    let y = all.classList.contains("on") || +range.value >= y1 ? y0 : +range.value + 1;
    set(y); play.textContent = "❚❚ Pause";
    timer = setInterval(() => { if (y >= y1) return stop(); set(++y); }, 900);
  });
})();
</script>
<script>{{ entities_js }}</script>
</body>
</html>
